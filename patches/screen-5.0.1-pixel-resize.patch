@@ -92,6 +94,26 @@
 	}
 
 	if (D_width == wi && D_height == he) {
+		/* A font change may alter pixels without changing the grid. Do not
+		 * reflow layers, but update full-window PTYs so the kernel sends
+		 * SIGWINCH to graphics applications. Keep split-region and hidden
+		 * windows out of this display-specific update. */
+		if (have_winsize) {
+			Canvas *cv;
+			for (cv = D_cvlist; cv; cv = cv->c_next) {
+				Window *p = Layer2Window(cv->c_layer);
+				struct winsize current;
+				if (!p || p->w_ptyfd < 0 || !p->w_pid ||
+				    p->w_width != wi || p->w_height != he)
+					continue;
+				if (ioctl(p->w_ptyfd, TIOCGWINSZ, &current) == 0 &&
+				    current.ws_col == glwz.ws_col &&
+				    current.ws_row == glwz.ws_row &&
+				    (current.ws_xpixel != glwz.ws_xpixel ||
+				     current.ws_ypixel != glwz.ws_ypixel))
+					ioctl(p->w_ptyfd, TIOCSWINSZ, &glwz);
+			}
+		}
 		return;
 	}
 	KillBlanker();
